---
// On Me — original bio with interactive word emphasis.
---
<section class="section on-me" id="on-me" data-section-id="on-me">
  <div class="section-inner">
    <h2 class="section-heading" data-color-letters data-inertial-text>on me</h2>

    <div class="bio">
      <p class="bio-education">2nd Year <span aria-hidden="true">|</span> B.S. <strong>Computer Science</strong>, San José State University</p>
      <p class="bio-lead">
        As a student beginning in <strong>Computer Science</strong>, one thing I can say in
        <em>high confidence</em>,
        <span data-syn-word data-syn-slot="0">massive change</span> is not only imminent but already fast in motion.
      </p>
      <p>
        In that change, people can, like much other change, push towards a
        <span data-syn-word data-syn-slot="1">better world</span> or break it down as we know it. For me, that
        makes my goal discovering the fields I am most interested in and joining initiatives
        utilizing this program to participate in <span data-syn-word data-syn-slot="2">meaningful</span>
        endeavors, build things, or simply message <span data-syn-word data-syn-slot="3">Claude Code</span>.
      </p>
    </div>


  </div>
</section>

<style>
  .on-me .section-inner { display: grid; gap: clamp(1.4rem, 3vw, 2.2rem); }
  .on-me .section-heading { margin-bottom: 0; }
  .on-me .bio {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem clamp(1.6rem, 4vw, 3rem);
    padding: clamp(1.25rem, 2.7vw, 2rem);
    border-left: 2px solid var(--accent-on-me);
    border-radius: 0 4px 4px 0;
    background: var(--bg-1);
    box-shadow: var(--shadow-card);
  }
  .on-me .bio .bio-education {
    grid-column: 1 / -1;
    padding-bottom: 1.2rem;
    border-bottom: 1px solid var(--hair-strong);
    font-size: var(--type-body);
    color: var(--text-2);
  }
  .bio-education span { margin-inline: .35rem; }
  .on-me .bio > p:not(.bio-education) { max-width: 68ch; }

  .on-me .bio p {
    margin: 0;
    font-family: var(--face-text);
    font-size: var(--type-body);
    line-height: 1.6;
    letter-spacing: normal;
    color: var(--text-1);
    max-width: none;
  }

  .on-me .bio .bio-lead {
    font-family: var(--face-display);
    font-variation-settings: 'SOFT' 75, 'WONK' 0;
    font-size: clamp(1.2rem, 2vw, 1.5rem);
    line-height: 1.4;
    color: var(--text-0);
  }

  .on-me .bio strong {
    font-weight: 600;
    color: var(--text-0);
  }

  .on-me .bio em {
    font-style: italic;
    font-variation-settings: 'SOFT' 90;
    color: color-mix(in srgb, var(--text-0) 88%, var(--accent));
  }

  /* Word emphasis (portfolio synesthesia). Dark: warm glow on walnut.
     Light: sunlit slots (brighter accents on parchment) + soft marker wash.
     Spec: Concept - Synesthesia Goals. */
  .on-me {
    --syn-slot-0: var(--accent-warm);
    --syn-slot-1: var(--accent-glow);
    --syn-slot-2: var(--accent-pale);
    --syn-slot-3: var(--accent);
    background-color: var(--bg-0);
    transition: background-color 1.2s ease;
  }

  /* Light mirrors dark: luminance lifts off the page, not deeper ink. */
  :root[data-theme='light'] .on-me {
    --syn-slot-0: var(--accent-bright);
    --syn-slot-1: var(--accent-glow);
    --syn-slot-2: var(--accent-bright);
    --syn-slot-3: var(--accent-warm);
  }

  .on-me [data-syn-word] {
    cursor: pointer;
    text-decoration: underline;
    text-decoration-style: dotted;
    text-decoration-color: color-mix(in srgb, var(--accent-on-me) 45%, transparent);
    text-underline-offset: 0.18em;
    transition:
      color 0.35s ease,
      text-decoration-color 0.35s ease,
      background-color 0.35s ease;
  }

  .on-me [data-syn-word][data-syn-active][data-syn-slot='0'] { color: var(--syn-slot-0); }
  .on-me [data-syn-word][data-syn-active][data-syn-slot='1'] { color: var(--syn-slot-1); }
  .on-me [data-syn-word][data-syn-active][data-syn-slot='2'] { color: var(--syn-slot-2); }
  .on-me [data-syn-word][data-syn-active][data-syn-slot='3'] { color: var(--syn-slot-3); }

  .on-me [data-syn-word][data-syn-active] {
    font-weight: 500;
    text-decoration-style: solid;
  }

  .on-me [data-syn-word][data-syn-active][data-syn-slot='0'] {
    text-decoration-color: color-mix(in srgb, var(--syn-slot-0) 70%, transparent);
  }
  .on-me [data-syn-word][data-syn-active][data-syn-slot='1'] {
    text-decoration-color: color-mix(in srgb, var(--syn-slot-1) 70%, transparent);
  }
  .on-me [data-syn-word][data-syn-active][data-syn-slot='2'] {
    text-decoration-color: color-mix(in srgb, var(--syn-slot-2) 70%, transparent);
  }
  .on-me [data-syn-word][data-syn-active][data-syn-slot='3'] {
    text-decoration-color: color-mix(in srgb, var(--syn-slot-3) 70%, transparent);
  }

  /* Light: manuscript marker + stronger room wash (parallel to dark candlelight). */
  :root[data-theme='light'] .on-me [data-syn-word][data-syn-active] {
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
    border-radius: 2px;
  }
  :root[data-theme='light'] .on-me [data-syn-word][data-syn-active][data-syn-slot='0'] {
    background-color: color-mix(in srgb, var(--syn-slot-0) 16%, transparent);
  }
  :root[data-theme='light'] .on-me [data-syn-word][data-syn-active][data-syn-slot='1'] {
    background-color: color-mix(in srgb, var(--syn-slot-1) 14%, transparent);
  }
  :root[data-theme='light'] .on-me [data-syn-word][data-syn-active][data-syn-slot='2'] {
    background-color: color-mix(in srgb, var(--accent-pale) 18%, transparent);
  }
  :root[data-theme='light'] .on-me [data-syn-word][data-syn-active][data-syn-slot='3'] {
    background-color: color-mix(in srgb, var(--syn-slot-3) 12%, transparent);
  }

  :root[data-theme='light'] .on-me.syn-tinted[data-syn-active-slot='0'] {
    background-color: color-mix(
      in srgb,
      var(--syn-slot-0) 14%,
      color-mix(in srgb, var(--accent-glow) 5%, var(--bg-0))
    );
  }
  :root[data-theme='light'] .on-me.syn-tinted[data-syn-active-slot='1'] {
    background-color: color-mix(
      in srgb,
      var(--syn-slot-1) 15%,
      color-mix(in srgb, var(--accent-glow) 5%, var(--bg-0))
    );
  }
  :root[data-theme='light'] .on-me.syn-tinted[data-syn-active-slot='2'] {
    background-color: color-mix(
      in srgb,
      var(--accent-pale) 14%,
      color-mix(in srgb, var(--accent-glow) 5%, var(--bg-0))
    );
  }
  :root[data-theme='light'] .on-me.syn-tinted[data-syn-active-slot='3'] {
    background-color: color-mix(
      in srgb,
      var(--syn-slot-3) 12%,
      color-mix(in srgb, var(--accent-glow) 4%, var(--bg-0))
    );
  }

  :root[data-theme='dark'] .on-me.syn-tinted[data-syn-active-slot='0'] {
    background-color: color-mix(in srgb, var(--syn-slot-0) 13%, var(--bg-0));
  }
  :root[data-theme='dark'] .on-me.syn-tinted[data-syn-active-slot='1'] {
    background-color: color-mix(in srgb, var(--syn-slot-1) 14%, var(--bg-0));
  }
  :root[data-theme='dark'] .on-me.syn-tinted[data-syn-active-slot='2'] {
    background-color: color-mix(in srgb, var(--syn-slot-2) 11%, var(--bg-0));
  }
  :root[data-theme='dark'] .on-me.syn-tinted[data-syn-active-slot='3'] {
    background-color: color-mix(in srgb, var(--syn-slot-3) 10%, var(--bg-0));
  }

  .on-me.syn-reduced-motion,
  .on-me.syn-reduced-motion [data-syn-word] {
    transition: none;
  }
</style>
