---
// On The Trail — coursework, skills, and resume.

const BASE = import.meta.env.BASE_URL;
const BASE_WITH_SLASH = BASE.endsWith('/') ? BASE : `${BASE}/`;
const resumeHref = `${BASE_WITH_SLASH}Rafan_Quader_Resume.pdf`;

const completedCourses: Array<{ label: string; href: string }> = [
  {
    label: 'Data Structures & Algorithms',
    href: 'https://catalog.sjsu.edu/preview_course_nopop.php?catoid=10&coid=42151',
  },
  {
    label: 'Discrete Mathematics',
    href: 'https://catalog.sjsu.edu/preview_course_nopop.php?catoid=10&coid=44161',
  },
  {
    label: 'Talking Back to Research: Critical Skills for Leaders (EDLD 10)',
    href: 'https://catalog.sjsu.edu/preview_course_nopop.php?catoid=13&coid=122976',
  },
];

const currentCourses = [
  { label: 'Introduction to Artificial Intelligence', href: 'https://catalog.sjsu.edu/preview_course_nopop.php?catoid=10&coid=42159' },
  { label: 'Introduction to Computer Systems', href: 'https://catalog.sjsu.edu/preview_course_nopop.php?catoid=10&coid=42150' },
  { label: 'Linear Algebra I', href: 'https://catalog.sjsu.edu/preview_course_nopop.php?catoid=10&coid=46030' },
];

const skillGroups = [
  { label: 'Languages', items: ['Java', 'Python'] },
  { label: 'Development Tools', items: ['Git', 'Claude Code', 'Codex', 'Cursor'] },
  {
    label: 'Professional Skills',
    items: [
      'Software Design & Development',
      'Presentation & Communication',
      'Collaborative Work',
    ],
  },
];
---

<section
  class="section on-the-trail"
  id="on-the-trail"
  data-section-id="on-the-trail"
>
  <div class="section-inner">
    <h2 class="section-heading" data-color-letters data-inertial-text>on the trail</h2>

    <div class="trail-panel">
    <p class="trail-education">
      B.S. Computer Science <span aria-hidden="true">·</span>
      San José State University <span>2025–2029</span>
    </p>

    <div class="trail-layout">
      <div class="trail-coursework">
        <div class="group">
          <h3>Completed Coursework</h3>
          <ul>
            {completedCourses.map(({ label, href }) => (
              <li>
                <a
                  class="trail-link"
                  href={href}
                  target="_blank"
                  rel="noopener noreferrer"
                >{label}</a>
              </li>
            ))}
          </ul>
        </div>

        <div class="group">
          <h3>Current Coursework</h3>
          <ul>
            {currentCourses.map(({ label, href }) => (
              <li><a class="trail-link" href={href} target="_blank" rel="noopener noreferrer">{label}</a></li>
            ))}
          </ul>
        </div>
      </div>

      <div class="trail-skills">
        {skillGroups.map(({ label, items }) => (
          <div class="group skill-group">
            <h3>{label}</h3>
            <ul>
              {items.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>

    <a class="btn-accent" href={resumeHref} download type="application/pdf">
      <span class="ico" aria-hidden="true">↓</span>
      <span>resume (PDF)</span>
    </a>
    </div>
  </div>
</section>

<style>
  .on-the-trail .section-inner { display: grid; gap: clamp(1.4rem, 3vw, 2.2rem); }
  .on-the-trail .section-heading { margin-bottom: 0; }
  .trail-panel {
    padding: clamp(1.25rem, 2.7vw, 2rem);
    border-left: 2px solid var(--accent-on-the-trail, var(--accent));
    border-radius: 0 4px 4px 0;
    background: var(--bg-1);
    box-shadow: var(--shadow-card);
    min-width: 0;
  }
  .trail-education {
    max-width: none;
    margin: 0 0 1.5rem;
    padding-bottom: 1.2rem;
    border-bottom: 1px solid var(--hair-strong);
    color: var(--text-1);
    font-size: var(--type-body);
  }
  .trail-education span:last-child {
    display: inline-block;
    margin-left: 0.5rem;
    color: var(--text-2);
  }
  .trail-layout {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem clamp(2rem, 5vw, 4rem);
    margin-bottom: 2rem;
  }
  .trail-coursework { display: contents; }
  .trail-layout .group { min-width: 0; }
  .trail-layout h3 {
    font-family: var(--face-display);
    font-size: clamp(1.17rem, 2vw, 1.45rem);
    margin-bottom: 0.75rem;
  }
  .trail-layout ul { list-style: none; padding: 0; margin: 0; }
  .trail-coursework li {
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--hair);
    color: var(--text-1);
    line-height: 1.4;
  }
  .trail-skills {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: minmax(0, .65fr) minmax(0, 1fr) minmax(0, 1.5fr);
    gap: 1.5rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--hair);
  }
  .trail-skills li {
    padding: 0.45rem 0;
    border-bottom: 1px solid var(--hair);
    color: var(--text-1);
    font-size: var(--type-body);
    line-height: 1.5;
  }
  .trail-link { color: inherit; text-decoration-color: var(--hair-strong); text-decoration-thickness: 1px; text-underline-offset: 0.2em; }
  .trail-link:hover { color: var(--accent); text-decoration-color: currentColor; }
  .trail-link:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
  @media (max-width: 760px) {
    .trail-layout { grid-template-columns: 1fr; gap: 1.75rem; }
    .trail-skills { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .trail-skills .group:last-child { grid-column: 1 / -1; }
  }
  @media (max-width: 430px) {
    .trail-skills { grid-template-columns: minmax(0, 1fr); }
  }
</style>
