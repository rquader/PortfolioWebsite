---
// Threshold — portrait, name, and an interactive shelf of featured work.
//
// Spec: [[Concept - Threshold Hero]]; specs/2026-05-22-gallery-v2-photo-sticker-design.md

import Photo from './photo/Photo.astro';
import FeaturedWork from './FeaturedWork.astro';
import TreeStudy from './TreeStudy.astro';
import '../styles/threshold.css';

import fs from 'node:fs';
import path from 'node:path';

const BASE = import.meta.env.BASE_URL;
const BASE_WITH_SLASH = BASE.endsWith('/') ? BASE : `${BASE}/`;
const photoPublicPath = '/images/rafan-speaking-1.jpg';
const photoDiskPath = path.join(process.cwd(), 'public', photoPublicPath);
const hasPhoto = fs.existsSync(photoDiskPath);

---
<section
  class="threshold"
  id="threshold"
  data-section-id="threshold"
  aria-label="introduction"
>
  <div class="threshold-intro">
    <div class="threshold-photo">
      <Photo
        src={`${BASE_WITH_SLASH}${(hasPhoto ? photoPublicPath : '/images/rafan-speaking-1.svg').replace(/^\//, '')}`}
        alt="Rafan Quader speaking at an event"
        treatment="print"
        aspect="1/1"
        loading="eager"
      />
    </div>
    <div class="threshold-content">
      <h1 class="name" data-color-letters>
        <span class="name-line">rafan</span>
        <span class="name-line">quader</span>
      </h1>
    </div>
  </div>

  <TreeStudy />
  <FeaturedWork />

  <a class="scroll-cue" href="#on-me">on me <svg viewBox="0 0 20 20" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M10 3v14m-5-5 5 5 5-5" /></svg></a>
</section>
